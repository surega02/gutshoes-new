APP_ENV=production
APP_DEBUG=false

# Resend through SMTP; no provider SDK is required.
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=replace-with-resend-api-key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=orders@mail.gutshoes.id
MAIL_FROM_NAME="GutShoes"

QUEUE_CONNECTION=redis
